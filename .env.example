PORT=3000

# Either set DATABASE_URL (managed Postgres) or the discrete DB_* values
# DATABASE_URL=postgres://user:pass@host:5432/cinema_db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=cinema_db
DB_SSL=false
# Auto-create tables from the entities. Fine for this project, turn off once migrations exist.
DB_SYNCHRONIZE=true

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=2h
TWO_FACTOR_ISSUER=CineReserva

# Multiplier applied to the showtime base price for VIP seats only (NORMAL seats keep the base price).
# Optional, defaults to 1.5 when unset.
VIP_PRICE_MULTIPLIER=1.5

# Optional overrides for the demo accounts created by the seed
# SEED_ADMIN_PASSWORD=Admin123
# SEED_COUNTER_PASSWORD=Counter123
# SEED_CUSTOMER_PASSWORD=Customer123
